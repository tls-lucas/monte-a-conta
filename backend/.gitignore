# ==========================================
# Monte a Conta - Git Ignore
# ==========================================

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo
.expo/
.expo-shared/
dist/
web-build/

# React Native
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Android
android/.gradle/
android/local.properties
android/app/build/
android/build/
android/.idea/
*.keystore

# iOS
ios/Pods/
ios/build/
ios/DerivedData/
*.xcworkspace/xcuserdata/
*.xcuserstate

# Metro / Babel
.metro-health-check*
.cache/
.babel-cache/

# Logs
logs/
*.log

# Environment variables / secrets
.env
.env.*
!.env.example

# Python backend
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/

# Flask
instance/
.pytest_cache/

# Backend generated files
backend/*.pdf
backend/relatorios/
backend/tmp/
backend/temp/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak

# Coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Generated archives
*.zip
*.tar
*.tar.gz
